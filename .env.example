# =============================================================================
# CRM OMNICANAL — Plantilla de credenciales
# =============================================================================
# Copiar a .env.local (dev) o .env (producción) y rellenar.
# NUNCA commitear el archivo con valores reales. .gitignore ya lo bloquea.
# Guía paso a paso para obtener cada valor: docs/CREDENCIALES.md
# =============================================================================


# -----------------------------------------------------------------------------
# 1. BASE DE DATOS (Postgres)  — REQUERIDO
# -----------------------------------------------------------------------------
# Local con Docker:  postgresql://crm:crm@localhost:5432/crm
# Neon:              postgresql://user:pass@ep-xxx.neon.tech/crm?sslmode=require
# Supabase:          postgresql://postgres.xxx:pass@aws-0-xx.pooler.supabase.com:6543/postgres
# Railway:           se inyecta sola como DATABASE_URL
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm


# -----------------------------------------------------------------------------
# 2. APP  — REQUERIDO
# -----------------------------------------------------------------------------
# URL pública. Meta exige HTTPS para el webhook.
APP_URL=http://localhost:3000

# Secreto de sesión (JWT). Generar:  openssl rand -base64 32
SESSION_SECRET=CAMBIAR_POR_32_BYTES_ALEATORIOS

# Login del panel (MVP mono-usuario; migrar a tabla users cuando haya equipo)
ADMIN_EMAIL=admin@tuempresa.com
ADMIN_PASSWORD=CAMBIAR_PASSWORD_FUERTE


# -----------------------------------------------------------------------------
# 3. META — COMÚN A LOS 3 CANALES  — REQUERIDO
# -----------------------------------------------------------------------------
# developers.facebook.com > Tu App > Configuración > Básica
META_APP_ID=
META_APP_SECRET=

# Token que TÚ inventas. Se pega igual en el panel de webhooks de Meta.
# Meta lo devuelve en la verificación GET del webhook.
META_WEBHOOK_VERIFY_TOKEN=inventa-un-string-largo-y-aleatorio

# Versión de Graph API usada por los adaptadores
META_GRAPH_VERSION=v21.0


# -----------------------------------------------------------------------------
# 4. WHATSAPP CLOUD API (oficial — sin riesgo de ban)
# -----------------------------------------------------------------------------
# Meta App > WhatsApp > Configuración de la API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Token permanente de System User (NO el temporal de 24h). Ver docs/CREDENCIALES.md
WHATSAPP_ACCESS_TOKEN=


# -----------------------------------------------------------------------------
# 5. FACEBOOK MESSENGER
# -----------------------------------------------------------------------------
# ID de la Página de Facebook
FACEBOOK_PAGE_ID=
# Page Access Token permanente (System User con acceso a la Página)
FACEBOOK_PAGE_ACCESS_TOKEN=


# -----------------------------------------------------------------------------
# 6. INSTAGRAM DIRECT
# -----------------------------------------------------------------------------
# ID de la cuenta profesional de IG vinculada a la Página
INSTAGRAM_ACCOUNT_ID=
# Normalmente es el MISMO Page Access Token que Messenger.
# Se deja separado por si en el futuro se usa otra Página.
INSTAGRAM_ACCESS_TOKEN=


# -----------------------------------------------------------------------------
# 7. IA — OPCIONAL (respuestas asistidas / resumen de conversación)
# -----------------------------------------------------------------------------
# Dejar vacío desactiva las funciones de IA. El CRM funciona sin esto.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5


# -----------------------------------------------------------------------------
# 8. RECORDATORIOS — OPCIONAL
# -----------------------------------------------------------------------------
# Protege /api/cron/reminders. Sin este valor la ruta responde 503.
# Llamada:  curl -H "Authorization: Bearer $CRON_SECRET" $APP_URL/api/cron/reminders
CRON_SECRET=

# Webhook interno donde se publica el resumen de tareas vencidas (Slack, Discord,
# n8n…). Vacío = el resumen solo va en la respuesta JSON.
# OJO: es para el equipo, nunca para contactos: un envío automático a un contacto
# rompería la ventana de 24 h (docs/ANTI-BAN.md).
REMINDERS_WEBHOOK_URL=


# -----------------------------------------------------------------------------
# 9. OPERACIÓN
# -----------------------------------------------------------------------------
# Zona horaria para métricas y recordatorios
TZ=America/Mexico_City
# SOLO DESARROLLO: 1 = los 3 canales se simulan y NO se llama a Graph API.
# Sirve para probar el CRM sin credenciales de Meta (ver docs/LOCAL.md).
# Con NODE_ENV=production la app se niega a arrancar si esto vale 1.
MOCK_CHANNELS=
# Moneda mostrada en montos
CURRENCY=MXN
NODE_ENV=development
